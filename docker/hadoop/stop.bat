@echo off
:: UTF-8 한글 깨짐 방지
chcp 65001 > nul

echo ==================================================
echo [HADOOP CLUSTER] 하둡 클러스터 컨테이너 정지 중...
echo ==================================================

:: docker-compose.yml 이 있는 위치로 이동하여 실행
cd /d "%~dp0"

:: 컨테이너를 정지하고 삭제합니다. (볼륨은 유지되므로 메타데이터 및 HDFS 데이터는 안전하게 보존됩니다)
docker compose down

echo ==================================================
echo [HADOOP CLUSTER] 모든 하둡 컨테이너가 성공적으로 정지되었습니다.
echo ==================================================
pause
