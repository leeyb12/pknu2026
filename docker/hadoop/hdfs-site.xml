<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet type="text/xsl" href="configuration.xsl"?>
<configuration>
    <!-- 학생 실습용: 파일 복제본 개수를 3개로 지정 (3개의 DataNode에 분산 저장됨) -->
    <property>
        <name>dfs.replication</name>
        <value>3</value>
    </property>

    <!-- NameNode가 메타데이터를 저장할 로컬 경로 -->
    <property>
        <name>dfs.namenode.name.dir</name>
        <value>file:///hadoop/dfs/name</value>
    </property>

    <!-- DataNode가 실제 데이터 블록을 저장할 로컬 경로 -->
    <property>
        <name>dfs.datanode.data.dir</name>
        <value>file:///hadoop/dfs/data</value>
    </property>

    <!-- 학생 실습용: 권한 검사를 꺼서 업로드/생성 시 Permission Denied 오류 예방 -->
    <property>
        <name>dfs.permissions.enabled</name>
        <value>false</value>
    </property>

    <!-- 클러스터 외부에 있는 클라이언트(웹 브라우저)가 DataNode 접속 시 IP가 아닌 호스트네임을 사용하도록 설정 -->
    <property>
        <name>dfs.client.use.datanode.hostname</name>
        <value>true</value>
    </property>
    <property>
        <name>dfs.datanode.use.datanode.hostname</name>
        <value>true</value>
    </property>
</configuration>
